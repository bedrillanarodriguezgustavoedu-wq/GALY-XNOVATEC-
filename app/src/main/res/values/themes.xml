<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Principal -->
    <style name="Theme.GALY" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- Tema para la Splash Screen (Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item> <!-- Fondo blanco limpio -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/icono</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.GALY</item>
    </style>
</resources>
